{
   "testPathIgnorePatterns": [
     "/node_modules/",
     "<rootDir>/dist/"
   ],
   "coveragePathIgnorePatterns": [
     "/node_modules/",
     "<rootDir>/dist/"
   ],
   "collectCoverage": true,
   "coverageReporters": ["json-summary", "text"],
   "coverageThreshold": {
     "global": {
       "lines": 80
     }
   }
}